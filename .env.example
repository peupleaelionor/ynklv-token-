# ─── YNKLV Environment Template ───────────────────────────────────────────────
# Copy to .env and fill in. Never commit real secrets.

# ── Chain / RPC ──
NEXT_PUBLIC_CHAIN_ID=84532                       # 8453 = Base mainnet, 84532 = Base Sepolia
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_WALLETCONNECT_ID=

# ── Contract addresses (per network — filled after deployment) ──
NEXT_PUBLIC_YNKLV_TOKEN_ADDRESS=
NEXT_PUBLIC_MEMBERSHIP_REGISTRY_ADDRESS=
NEXT_PUBLIC_REWARDS_VAULT_ADDRESS=
NEXT_PUBLIC_CREATOR_DISTRIBUTOR_ADDRESS=

# ── Deployment (server-only — NEVER expose) ──
DEPLOYER_PRIVATE_KEY=
BASESCAN_API_KEY=

# ── Backend / Indexer ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=postgresql://localhost:5432/ynklv
INDEXER_START_BLOCK=0

# ── API ──
API_PORT=4000
API_RATE_LIMIT_PUBLIC=60
API_RATE_LIMIT_AUTH=300

# ── Payments (regulated providers — see packages/payments) ──
# EUR on/off-ramp requires a LICENSED provider with KYC/AML. Placeholder keys only.
COINBASE_COMMERCE_API_KEY=
STRIPE_SECRET_KEY=
ONRAMP_PROVIDER_API_KEY=
