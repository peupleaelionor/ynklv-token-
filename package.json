{
  "name": "ynklv",
  "version": "0.1.0",
  "private": true,
  "description": "YANKELV — the Afro-global digital asset ecosystem. Reusable Web3 infrastructure, token utility system, and multi-project integration SDK.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "contracts:test": "pnpm --filter @ynklv/contracts test",
    "contracts:build": "pnpm --filter @ynklv/contracts build",
    "contracts:deploy:base-sepolia": "pnpm --filter @ynklv/contracts deploy:base-sepolia",
    "contracts:deploy:base": "pnpm --filter @ynklv/contracts deploy:base",
    "contracts:verify": "pnpm --filter @ynklv/contracts verify",
    "setup": "node scripts/setup.mjs",
    "seed": "pnpm --filter @ynklv/api seed",
    "chain:local": "pnpm --filter @ynklv/contracts anvil"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
